# Database (required for Vercel — file storage doesn't persist between deployments)
DATABASE_URL=postgresql://user:password@host/dbname

# TON API keys
NEXT_PUBLIC_TON_API_KEY=
NEXT_PUBLIC_TONCENTER_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_WEBAPP_URL=

# TonConnect manifest (set to your Vercel URL)
NEXT_PUBLIC_TONCONNECT_MANIFEST_URL=https://YOUR-VERCEL-DOMAIN.vercel.app/tonconnect-manifest.json

# Public API URL (leave empty to use Next.js API routes on same domain)
NEXT_PUBLIC_API_URL=

# Upload storage: "local" or "s3"
UPLOAD_STORAGE=local

# S3 (optional)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# Dev: allow demo wallet without real TON wallet
NEXT_PUBLIC_ALLOW_DEMO_WALLET=false
